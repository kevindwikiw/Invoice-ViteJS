FACE_WORKER_TOKEN=replace-with-a-long-random-token
FACE_WORKER_CALLBACK_ORIGIN=http://127.0.0.1:3000
FACE_WORKER_CALLBACK_TOKEN=replace-with-the-same-face-worker-internal-token-used-by-fly
# Set after deploying the API drive-token endpoint. No Google private key on the worker.
FACE_WORKER_PHOTO_SOURCE=drive
FACE_WORKER_MEDIA_ROOT=
# Empty means the verified models/ directory next to main.py.
FACE_WORKER_MODEL_DIR=
FACE_WORKER_HOST=127.0.0.1
FACE_WORKER_PORT=8088
FACE_WORKER_MAX_CONCURRENT=1
FACE_WORKER_PHOTO_CONCURRENCY=3
FACE_WORKER_INTRA_OP_THREADS=2
FACE_WORKER_HTTP_TIMEOUT_SECONDS=30
FACE_WORKER_MAX_IMAGE_BYTES=15728640
FACE_WORKER_MAX_IMAGE_PIXELS=40000000
FACE_WORKER_MAX_PHOTOS_PER_JOB=10000
FACE_WORKER_MAX_EMBEDDING_JSON_BYTES=20971520
FACE_WORKER_MAX_EMBEDDING_RECORDS=100000
FACE_WORKER_CACHE_MAX_BYTES=134217728
FACE_WORKER_CACHE_MAX_ENTRIES=16
FACE_WORKER_CACHE_TTL_SECONDS=900
