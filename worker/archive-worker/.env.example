FACE_ARCHIVE_WORKER_TOKEN=replace-with-a-new-long-random-archive-token
FACE_ARCHIVE_WORKER_CALLBACK_ORIGIN=http://localhost:3000
# Match FACE_WORKER_INTERNAL_TOKEN on Fly for the existing Drive-token callback.
FACE_ARCHIVE_WORKER_CALLBACK_TOKEN=replace-with-the-fly-internal-callback-token
FACE_ARCHIVE_WORKER_DIR=/opt/orbit-archive-worker/archives
FACE_ARCHIVE_WORKER_HTTP_TIMEOUT_SECONDS=30
FACE_ARCHIVE_WORKER_MAX_BYTES=21474836480
FACE_ARCHIVE_WORKER_MAX_PHOTOS=2000
FACE_ARCHIVE_WORKER_MAX_ACTIVE=4
FACE_ARCHIVE_WORKER_CONCURRENCY=1
FACE_ARCHIVE_WORKER_TTL_SECONDS=21600
FACE_ARCHIVE_WORKER_PREBUILD_TTL_SECONDS=2592000
FACE_ARCHIVE_WORKER_CACHE_MAX_BYTES=85899345920
FACE_ARCHIVE_WORKER_MIN_FREE_BYTES=5368709120
FACE_ARCHIVE_WORKER_MAX_PREBUILD_JOBS=128
