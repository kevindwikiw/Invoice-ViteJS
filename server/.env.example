# JWT Configuration
JWT_SECRET=your-64-char-random-secret-here-replace-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS - Allowed Origins (comma separated)
ALLOWED_ORIGINS=https://your-domain.com

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_ATTEMPTS=5

# Environment
NODE_ENV=production
PORT=3000

# Runtime storage. On Fly, use the mounted volume paths from fly.toml.
SQLITE_PATH=/data/sqlite.db
UPLOAD_DIR=/data/uploads/proofs
STATIC_DIR=/app/client/dist

# Required only when initializing an empty database
SEED_SUPERADMIN_PASSWORD=replace-with-a-strong-password
SEED_ADMIN_PASSWORD=replace-with-a-strong-password
SEED_EMPLOYEE_PASSWORD=replace-with-a-strong-password
