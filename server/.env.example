# JWT Configuration
JWT_SECRET=your-64-char-random-secret-here-replace-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS - Allowed Origins (comma separated)
ALLOWED_ORIGINS=https://your-domain.com

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_ATTEMPTS=5
FEEDBACK_RATE_LIMIT_WINDOW_MS=3600000
FEEDBACK_RATE_LIMIT_MAX=5

# Dedicated feedback database (Turso Cloud). Both values are required together.
# Without these, only local SQLite development can store feedback.
TURSO_DATABASE_URL=libsql://your-feedback-database-your-org.turso.io
TURSO_AUTH_TOKEN=replace-with-your-turso-database-token

# Environment
NODE_ENV=production
PORT=3000

# Optional WhatsApp link shown to clients when a gallery is closed.
# Example: https://wa.me/6281234567890
GALLERY_CONTACT_WHATSAPP_URL=

# Database: local development defaults to SQLite when DATABASE_DRIVER and
# DATABASE_URL are absent. Do not point production at SQLite.
# DATABASE_DRIVER=sqlite
SQLITE_PATH=/data/sqlite.db

# Cloud cutover (uncomment only after running db/migrations/001_initial_schema.sql
# in the existing Supabase project). Use the Supabase session pooler URL for Fly.
# DATABASE_DRIVER=postgres
# SUPABASE_DB_URL=postgres://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# DATABASE_SSL=true
# DATABASE_POOL_MAX=5

# Frontend static files served by the Hono production process.
STATIC_DIR=/app/client/dist

# Required only when initializing an empty database
SEED_SUPERADMIN_PASSWORD=replace-with-a-strong-password
SEED_ADMIN_PASSWORD=replace-with-a-strong-password
SEED_EMPLOYEE_PASSWORD=replace-with-a-strong-password
