{
  "name": "invoice-web-v2",
  "private": true,
  "packageManager": "bun@1.3.7",
  "workspaces": [
    "client",
    "server"
  ],
  "overrides": {
    "esbuild": ">=0.25.4"
  },
  "scripts": {
    "dev:client": "bun --cwd client dev",
    "dev:server": "bun --cwd server dev",
    "build": "bun --cwd client build",
    "lint": "bun --cwd client lint",
    "typecheck": "bun --cwd client typecheck",
    "test": "bun --cwd client test:smoke"
  }
}
