# Copy this file to fly.secrets.env, replace every placeholder, and import it
# with: Get-Content fly.secrets.env | fly secrets import -a invoice-web-v2
# Never commit fly.secrets.env.
JWT_SECRET=replace-with-a-new-random-production-secret
SEED_SUPERADMIN_PASSWORD=replace-with-a-strong-password
SEED_ADMIN_PASSWORD=replace-with-a-strong-password
SEED_EMPLOYEE_PASSWORD=replace-with-a-strong-password

# Keep these only if/when the Hono Supabase adapter is enabled.
SUPABASE_SECRET_KEY=replace-with-your-supabase-backend-secret
