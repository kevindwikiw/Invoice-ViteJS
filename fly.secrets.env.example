# Copy this file to fly.secrets.env, replace every placeholder, and import it
# with: Get-Content fly.secrets.env | fly secrets import -a invoice-web-v2
# Never commit fly.secrets.env.
JWT_SECRET=replace-with-a-new-random-production-secret
TURSO_DATABASE_URL=libsql://your-feedback-database-your-org.turso.io
TURSO_AUTH_TOKEN=replace-with-your-turso-database-token
SEED_SUPERADMIN_PASSWORD=replace-with-a-strong-password
SEED_ADMIN_PASSWORD=replace-with-a-strong-password
SEED_EMPLOYEE_PASSWORD=replace-with-a-strong-password

# Set these after running db/migrations/001_initial_schema.sql in Supabase.
# Prefer the Supabase session pooler connection string for Fly's IPv4 network.
# DATABASE_DRIVER=postgres
# SUPABASE_DB_URL=postgres://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# DATABASE_SSL=true
# DATABASE_POOL_MAX=5

# Used only when Supabase Storage is enabled for proof files.
SUPABASE_SECRET_KEY=replace-with-your-supabase-backend-secret
